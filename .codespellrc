[codespell]
ignore-words = .github/linters/codespell.txt
# re_prop.h is generated from the Unicode Character Database and carries the
# database's own names for the scripts, which read as misspelled English: Vai
# as "via", Bengali's short name `beng` as "being". Nothing in it is prose.
skip = ./build,./doc/api,./doc/capi,*/re_prop.h
