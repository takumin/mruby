[codespell]
ignore-words = .github/linters/codespell.txt
# corpus.rb and re_prop.h are generated from the Unicode Character Database and
# carry the database's own names for the scripts, which read as misspelled
# English: Vai as "via", Bengali's short name `beng` as "being". Nothing in
# either is prose.
skip = ./build,./doc/api,./doc/capi,*/difftest/corpus.rb,*/re_prop.h
