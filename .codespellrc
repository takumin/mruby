[codespell]
ignore-words = .github/linters/codespell.txt
# Both are generated from the Unicode Character Database and carry the
# database's own names for the scripts, which read as misspelled English: Vai
# as "via", Bengali's short name `beng` as "being". Neither holds prose.
skip = ./build,./doc/api,./doc/capi,*/re_prop.h,*/difftest/corpus.rb
